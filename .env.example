# Predictive & Explainable Self-Healing CI/CD Platform Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Ollama Local LLM Configuration
OLLAMA_BASE_URL=http://localhost:11434
LLM_REASONING_MODEL=qwen2.5:3b
LLM_CODE_MODEL=qwen2.5:3b
EMBEDDING_MODEL=nomic-embed-text

# Storage & Persistence
CHROMA_PERSIST_DIR=/home/ubuntu/predictive-self-healing-cicd/data/chroma
DATABASE_PATH=/home/ubuntu/predictive-self-healing-cicd/data/platform.db
AUDIT_LOG_PATH=/home/ubuntu/predictive-self-healing-cicd/data/audit.jsonl
MODELS_DIR=/home/ubuntu/predictive-self-healing-cicd/src/models/saved_models

# Sourcegraph Integration (Running locally on EC2 via Docker)
SOURCEGRAPH_URL=http://localhost:7080
SOURCEGRAPH_TOKEN=

# Target Workspace / Demo Repository
DEMO_REPO_PATH=/home/ubuntu/predictive-self-healing-cicd/demo_repo

# Self-Healing & Safety Policy Limits
AUTO_APPLY_MAX_RISK=40.0
MAX_PATCH_LINES=50
MAX_LLM_TIMEOUT_SECONDS=180
